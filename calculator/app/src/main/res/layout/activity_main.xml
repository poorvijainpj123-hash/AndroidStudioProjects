<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="bottom|end"
        android:text="0"
        android:textColor="#000000"
        android:textSize="48sp"
        android:padding="8dp" />

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btnClear" style="@style/CalcFn" android:text="AC" />
        <Button android:id="@+id/btndelete" style="@style/CalcFn" android:text="del" />
        <Button android:id="@+id/btnPercent" style="@style/CalcFn" android:text="%" />
        <Button android:id="@+id/btnDivide" style="@style/CalcOp" android:text="÷" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btn7" style="@style/CalcNum" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalcNum" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalcNum" android:text="9" />
        <Button android:id="@+id/btnMultiply" style="@style/CalcOp" android:text="×" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btn4" style="@style/CalcNum" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalcNum" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalcNum" android:text="6" />
        <Button android:id="@+id/btnSubtract" style="@style/CalcOp" android:text="−" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btn1" style="@style/CalcNum" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalcNum" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalcNum" android:text="3" />
        <Button android:id="@+id/btnAdd" style="@style/CalcOp" android:text="+" />
    </LinearLayout>

    <!-- Row 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btn0" style="@style/CalcNum"
            android:layout_width="0dp"
            android:layout_weight="2" android:text="0" />
        <Button android:id="@+id/btnDecimal" style="@style/CalcNum" android:text="." />
        <Button android:id="@+id/btnEquals" style="@style/CalcOp" android:text="=" />
    </LinearLayout>

</LinearLayout>