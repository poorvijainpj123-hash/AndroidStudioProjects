<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="CalcNum" parent="CalcBase">
        <item name="android:backgroundTint">#333336</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="CalcFn" parent="CalcBase">
        <item name="android:backgroundTint">#A5A5AA</item>
        <item name="android:textColor">#000000</item>
    </style>
    <style name="CalcOp" parent="CalcBase">
        <item name="android:backgroundTint">#FF9F0A</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>